# Used only on your laptop by load_to_supabase.py. Never put this in the app or in git.
# Supabase dashboard > Connect > Session pooler (IPv4). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Used only by seed_demo.py to upload the demo report photos. Laptop only:
# the service role key skips every security rule, so never put it in the app,
# in git or in a chat. Dashboard > Project Settings > API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
