# Copy to app/.env and fill in from Supabase > Project Settings > API.
# Only these two public values may reach the app. The anon key is safe to ship
# because Row Level Security protects every table.
# NEVER put the service_role key here or anywhere in app/.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
