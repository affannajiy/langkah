# Copy to app/.env and fill in.
# Only these public values may reach the app. The anon key is safe to ship
# because Row Level Security protects every table.
# NEVER put the service_role key here or anywhere in app/.

# Supabase > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Cloud > APIs & Services > Credentials: the "Web application" OAuth client ID.
# Public by design (it is sent with every sign-in). The client SECRET goes only into
# Supabase > Authentication > Sign In / Providers > Google, never here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
